/* ============================================================================
   Vim Mode - Nightshift

   The block cursor covers a character, so it cannot simply be tinted: whatever
   fills it has to have the ground knocked out of it, or the character you are
   sitting on becomes the one character you cannot read.
   ============================================================================ */

.cm6-theme-ironworks-nightshift .cm-fat-cursor,
[data-cm6-theme="ironworks-nightshift"] .cm-fat-cursor {
  background: #e07c3f !important;
  color: #171412 !important;
}

.cm6-theme-ironworks-nightshift .cm-editor:not(.cm-focused) .cm-fat-cursor,
[data-cm6-theme="ironworks-nightshift"] .cm-editor:not(.cm-focused) .cm-fat-cursor {
  background: transparent !important;
  outline: 1px solid #7a5a44;
  color: inherit !important;
}

.cm6-theme-ironworks-nightshift .cm-vim-panel,
[data-cm6-theme="ironworks-nightshift"] .cm-vim-panel {
  background: #1f1b18;
  border-color: #2e2823;
  color: #d9d0c4;
}

.cm6-theme-ironworks-nightshift .cm-vim-panel input,
[data-cm6-theme="ironworks-nightshift"] .cm-vim-panel input {
  background: #171412;
  color: #d9d0c4;
  border-color: #2e2823;
}

