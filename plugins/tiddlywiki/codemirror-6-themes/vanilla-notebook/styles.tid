/* ============================================================================
   Vim Mode - Day

   The block cursor covers a character, so it cannot simply be tinted: whatever
   fills it has to have the page colour knocked out of it, or the character you
   are sitting on becomes the one character you cannot read.
   ============================================================================ */

.cm6-theme-vanilla-notebook-day .cm-fat-cursor,
[data-cm6-theme="vanilla-notebook-day"] .cm-fat-cursor {
  background: #31527d !important;
  color: #fdfcf8 !important;
}

.cm6-theme-vanilla-notebook-day .cm-editor:not(.cm-focused) .cm-fat-cursor,
[data-cm6-theme="vanilla-notebook-day"] .cm-editor:not(.cm-focused) .cm-fat-cursor {
  background: transparent !important;
  outline: 1px solid #8ba0bd;
  color: inherit !important;
}

.cm6-theme-vanilla-notebook-day .cm-vim-panel,
[data-cm6-theme="vanilla-notebook-day"] .cm-vim-panel {
  background: #fbfaf6;
  border-color: #e4dfd0;
  color: #26241f;
}

.cm6-theme-vanilla-notebook-day .cm-vim-panel input,
[data-cm6-theme="vanilla-notebook-day"] .cm-vim-panel input {
  background: #fdfcf8;
  color: #26241f;
  border-color: #e4dfd0;
}

