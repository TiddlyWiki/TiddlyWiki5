/* ============================================================================
   Vanilla Notebook Theme for CodeMirror 6
   ============================================================================

   Paper and ink. The two variants take their surfaces straight from the
   Vanilla Notebook palettes that ship with the $:/themes/BurningTreeC/
   vanilla-notebook page theme, so an editor themed this way sits on the same
   paper as the tiddler around it instead of on a panel of its own.

   The theme is self-contained and does not require that page theme. Every
   value here is a literal, like every other theme in this collection, so
   picking it under any palette gives the same editor.

   ----------------------------------------------------------------------------
   How the syntax colours were chosen
   ----------------------------------------------------------------------------

   One lightness, ten hues. Every token colour in a variant sits at the same
   OKLCH lightness - 0.44 on Day, 0.84 on Night - and differs only in hue.

   That is the opposite of how most syntax schemes are built, and it is
   deliberate. Uniform lightness means the eye reads the SHAPE of the code
   first, which is what you actually navigate by, and colour is left to say
   what kind of thing a token is rather than competing for attention. It also
   means every token has the same contrast against the paper, so there is no
   role that quietly becomes unreadable: measured against the editor
   background, Day runs 6.50:1 to 8.23:1 and Night 9.38:1 to 11.13:1.

   Hues are spaced far enough apart to stay distinguishable - roughly 30 to 40
   degrees between neighbours - and the ones that matter most for wikitext
   (widgets, transclusions, filters, macros) sit at the well-separated ends.

   Errors are the single exception: they carry extra chroma, because an error
   is the one token that should catch the eye before you look for it.

   Day paper:   #fdfcf8    Day ink:   #26241f
   Night paper: #1b1a16    Night ink: #ddd8cb

   ============================================================================ */

/* ============================================================================
   Vanilla Notebook Day
   ============================================================================ */

.cm6-theme-vanilla-notebook-day,
[data-cm6-theme="vanilla-notebook-day"] {
  /* Base palette - cream paper, warm ink */
  --wt-bg: #fdfcf8;
  --wt-bg-subtle: #f2efe6;
  --wt-fg: #26241f;
  --wt-fg-muted: #44423d;
  --wt-fg-faint: #6f6d69;
  --wt-border: #e4dfd0;
  --wt-selection: rgba(49, 82, 125, 0.22);
  --wt-line-highlight: rgba(49, 82, 125, 0.06);

  /* Semantic colours - one lightness, ten hues */
  --wt-teal: #006860;           /* widgets */
  --wt-teal-dim: #2c7a73;
  --wt-blue: #1c509a;           /* links */
  --wt-violet: #703681;         /* transclusions */
  --wt-cyan: #005d8b;           /* filters */
  --wt-orange: #883600;         /* macros */
  --wt-rose: #8a2a49;           /* conditionals */
  --wt-amber: #774600;          /* attributes */
  --wt-slate: #44423d;          /* code text */
  --wt-purple: #564094;         /* pragmas */
  --wt-green: #006522;          /* strings */
  --wt-red: #971927;            /* errors */

  /* Formatting - emphasis is carried by weight and slope, not by more hues */
  --wt-bold: #26241f;
  --wt-italic: #26241f;
  --wt-strike: #878581;
  --wt-underline: #26241f;
  --wt-heading: #26241f;

  /* Code blocks */
  --wt-code-bg: #f2efe6;
  --wt-code-fg: #8a3324;

  /* Highlight - the margin rule's own red, which is what marks a page in this
     theme */
  --wt-highlight-bg: rgba(176, 58, 46, 0.16);
  --wt-highlight-fg: #26241f;

  /* Comments */
  --wt-comment: #55544f;
  --wt-mark: #e8e2d2;
}

/* ============================================================================
   Vanilla Notebook Night
   ============================================================================ */

.cm6-theme-vanilla-notebook-night,
[data-cm6-theme="vanilla-notebook-night"] {
  /* Base palette - writing after dark, warm dark paper */
  --wt-bg: #1b1a16;
  --wt-bg-subtle: #26251f;
  --wt-fg: #ddd8cb;
  --wt-fg-muted: #c2bdb2;
  --wt-fg-faint: #9b978d;
  --wt-border: #35332b;
  --wt-selection: rgba(143, 176, 221, 0.24);
  --wt-line-highlight: rgba(143, 176, 221, 0.07);

  /* Semantic colours - same hues, lifted for dark paper */
  --wt-teal: #6fe1d7;           /* widgets */
  --wt-teal-dim: #55b4ac;
  --wt-blue: #a0cdff;           /* links */
  --wt-violet: #e7b5f7;         /* transclusions */
  --wt-cyan: #7bd8ff;           /* filters */
  --wt-orange: #ffb78a;         /* macros */
  --wt-rose: #ffaec1;           /* conditionals */
  --wt-amber: #efc379;          /* attributes */
  --wt-slate: #c2bdb2;          /* code text */
  --wt-purple: #ccbeff;         /* pragmas */
  --wt-green: #9bdea4;          /* strings */
  --wt-red: #ffa7a4;            /* errors */

  /* Formatting */
  --wt-bold: #ddd8cb;
  --wt-italic: #ddd8cb;
  --wt-strike: #86827a;
  --wt-underline: #ddd8cb;
  --wt-heading: #ddd8cb;

  /* Code blocks */
  --wt-code-bg: #26251f;
  --wt-code-fg: #d99a7e;

  /* Highlight */
  --wt-highlight-bg: rgba(212, 116, 106, 0.20);
  --wt-highlight-fg: #ddd8cb;

  /* Comments */
  --wt-comment: #b2aea3;
  --wt-mark: #2e2c25;
}

