title: $:/core/ui/EditorToolbar/preview-type-dropdown

\whitespace trim

\define preview-type-button()
<$button tag="a" class={{{ [[tc-btn-invisible]] [{$:/state/editpreviewtype}!match[]else[$:/core/ui/EditTemplate/body/preview/output]match<previewType>then[tc-list-item-selected]else[]] +[join[ ]] }}}><$action-setfield $tiddler="$:/state/editpreviewtype" $value=<<previewType>>/><$action-deletetiddler $tiddler=<<dropdown-state>>/><$transclude tiddler=<<previewType>> field="caption" mode="inline"><$view tiddler=<<previewType>> field="title" mode="inline"/></$transclude></$button>
\end

<$list filter="[all[shadows+tiddlers]tag[$:/tags/EditPreview]!has[draft.of]]" variable="previewType"><$let previewCondition={{{ [<previewType>get[condition]else[yes]] }}}><% if [<tv-editor-type>] +[subfilter<previewCondition>] %><<preview-type-button>><% endif %></$let></$list>
