<%if [{$:/view}!match[zoomin]] %>

	@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {

		.tc-story-river-masonry {
			column-count: {{$:/config/StoryRiver/masonry-columns}};
			column-gap: 28px;
		}

		.tc-story-river-masonry > .tc-live-reorderable {
			break-inside: avoid;
			width: 100%;
			--tc-live-reorder-drop-target-offset: 0px;
		}

		.tc-story-river-masonry > .tc-live-reorderable > .tc-tiddler-frame {
			width: 100%;
			margin-left: 0;
			margin-right: 0;
		}

	}

<% endif %>