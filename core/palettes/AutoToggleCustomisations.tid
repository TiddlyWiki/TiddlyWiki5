title: $:/palettes/AutoToggle/Customisations

\procedure layer-input-actions()
<$let
	paletteImportLight={{{ [<layerTitle>has[palette-import@light]get[palette-import@light]] :else[{$:/palette}get[palette-import@light]] }}}
	paletteImportDark={{{ [<layerTitle>has[palette-import@dark]get[palette-import@dark]] :else[{$:/palette}get[palette-import@dark]] }}}
>
	<%if [<layerTitle>!type[application/x-tiddler-dictionary]] %>
		<$action-setfield $tiddler=<<layerTitle>> type="application/x-tiddler-dictionary"/>
	<% endif %>
	<%if [<field>suffix[@light]] %>
		<%if [<layerTitle>!has[palette-import@dark]] [<layerTitle>get[palette-import@dark]!match<paletteImportDark>] %>
			<$action-setfield $tiddler=<<layerTitle>> palette-import@dark=<<paletteImportDark>>/>
		<% endif %>
	<%elseif [<field>suffix[@dark]] %>
		<%if [<layerTitle>!has[palette-import@light]] [<layerTitle>get[palette-import@light]!match<paletteImportLight>] %>
			<$action-setfield $tiddler=<<layerTitle>> palette-import@light=<<paletteImportLight>>/>
		<% endif %>
	<% endif %>
</$let>
<$action-setfield $tiddler=<<layerTitle>> palette-import={{$:/palette}}/>
\end layer-input-actions

\procedure set-imported-palette(field)
<$select field=<<field>> default={{{ [[$:/temp/palette-consolidated]get<field>] }}} actions=<<layer-input-actions>>>
	<$list filter="[all[shadows+tiddlers]tag[$:/tags/Palette]sort[name]] -[{$:/palette}]">
		<option value=<<currentTiddler>>><$view field="name"><$view field="title"/></$view></option>
	</$list>
</$select>
\end set-imported-palette

This palette can be used to automatically switch between two palettes based on the browser's dark mode setting.

<$let layerTitle={{{ [function[tf.palette-customisations-layer]] }}}>
<$tiddler tiddler=<<layerTitle>>>

Light palette: <<set-imported-palette field:"palette-import@light">>

Dark palette: <<set-imported-palette field:"palette-import@dark">>

</$tiddler>
</$let>
