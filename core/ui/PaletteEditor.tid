title: $:/PaletteEditor

\define lingo-base() $:/language/ControlPanel/Palette/Editor/
\define describePaletteColour(colour)
<$transclude tiddler="$:/language/Docs/PaletteColours/$colour$"><$text text="$colour$"/></$transclude>
\end
\define edit-colour-placeholder()
 edit $(colourName)$
\end
\define colour-tooltip(showhide) $showhide$ editor for $(newColourName)$ 

\function tf.palette.get.colour(index) [{$:/palette}getindex<index>] :else[{$:/palette}get[palette-import]getindex<index>]

\procedure tp-colour-widget-regexp() ^\s*<\$(?:macrocall|transclude)\b[^>]*\bname=(?:"""([^"]*)"""|'''([^']*)'''|"([^"]*)"|'([^']*)'|([^␠/>]+))[^>]*/>\s*$
\procedure tp-colour-macro-regexp() ^\s*<<colou?r␠(?:name(?:=|:)␠*)?(?:"""([^"]*)"""|'''([^']*)'''|"([^"]*)"|'([^']*)'|([^␠>]+))>>\s*$
\procedure tp-colour-filter-regexp() ^\s*\[tf\.colour\[([^\]]+)\]\]\s*$
\procedure tp-colour-filters-regexp() (?:colour-(?:best-contrast|composite|contrast|darken|get-oklch|interpolate|lighten|set-(?:alpha|oklch))|tf\.interpolate-colours)(?![\w-])

\function tf.palette.colours.get.colour(index) [[$:/temp/palette-colours]getindex<index>]
\function tf.copy.palette.colours.get.colour(index) [[$:/temp/palette-colours/copy]getindex<index>]
\function tf.copy.palette.colours.get.colour.wrapper() [tf.copy.palette.colours.get.colour<colourName>]

\function tf.resolve.colour.name(name)
[tf.extract.colour.name.step<name>] =>next
[<next>match<name>then<next>]
:else[tf.resolve.colour.name<next>]
\end tf.resolve.colour.name

\function tf.extract.colour.name.step(name)
[tf.palette.get.colour<name>is[colour]then<name>] =>valueA
[tf.palette.get.colour<name>split[ ]join[␠]] =>value
[[value]is[variable]then<value>extractregexp<tp-colour-macro-regexp>] =>valueB
[[value]is[variable]then<value>extractregexp<tp-colour-widget-regexp>] =>valueC
[[value]is[variable]then<value>extractregexp<tp-colour-filter-regexp>] =>valueD
[<valueA>!is[blank]else<valueB>!is[blank]else<valueC>!is[blank]else<valueD>!is[blank]] =>value
[<value>!is[blank]else<name>]
\end tf.extract.colour.name.step

\function tf.copy.resolve.colour.name(name)
[tf.copy.extract.colour.name.step<name>] =>next
[<next>match<name>then<next>]
:else[tf.copy.resolve.colour.name<next>]
\end tf.copy.resolve.colour.name

\function tf.copy.extract.colour.name.step(name)
[tf.copy.palette.colours.get.colour<name>is[colour]then<name>] =>valueA
[tf.copy.palette.colours.get.colour<name>split[ ]join[␠]] =>value
[[value]is[variable]then{$:/palette}getindex<value>is[colour]then<value>] =>valueB
[[value]is[variable]then{$:/palette}get[palette-import]getindex<value>is[colour]then<value>] =>valueC
[[value]is[variable]then<value>extractregexp<tp-colour-macro-regexp>] =>valueD
[[value]is[variable]then<value>extractregexp<tp-colour-widget-regexp>] =>valueE
[[value]is[variable]then<value>extractregexp<tp-colour-filter-regexp>] =>valueF
[<valueA>!is[blank]else<valueB>!is[blank]else<valueC>!is[blank]else<valueD>!is[blank]else<valueE>!is[blank]else<valueF>!is[blank]] =>value
[<value>!is[blank]else<name>]
\end tf.copy.extract.colour.name.step

\function tf.resolve.colour.name.wrapper() [tf.resolve.colour.name<colourName>]

\function tf.palette.get.colour.wrapper() [tf.palette.get.colour<colourName>]

\procedure tp-paletteeditor-input-actions()
<$let colourValue={{{ [tf.copy.resolve.colour.name<colourName>] :map[tf.copy.palette.colours.get.colour<currentTiddler>] }}}>
<%if [<colourValue>is[colour]] %>
<$action-setfield $index=<<colourName>> $value={{{ [<colourEditTiddler>getindex<colourName>] }}}/>
<%elseif [<colourValue>is[blank]] [<colourValue>match[]] %>
<$action-setfield $index=<<colourName>> $value=""/>
<% endif %>
</$let>
\end

\procedure tp-paletteeditor-resolved-input-actions()
<$let colourValue={{{ [<colourEditTiddler>get[text]] :map:flat[tf.copy.resolve.colour.name<currentTiddler>] =>colourName [tf.copy.palette.colours.get.colour<colourName>] }}}>
<%if [<colourValue>is[colour]] %>
<$action-setfield $index=<<colourName>> $value={{{ [<colourEditTiddler>get[text]] }}}/>
<%elseif [<colourValue>is[blank]] [<colourValue>match[]] %>
<$action-setfield $index=<<colourName>> $value=""/>
<% endif %>
</$let>
\end

\procedure tp-paletteeditor-colour-input-actions()
<$action-setfield $tiddler=<<colourEditTiddler>> text=<<actionValue>>/>
<$action-setfield $tiddler=<<colourRefreshTitle>> text="yes"/>
\end

\procedure tp-paletteeditor-dropdown-button-show-actions()
<$action-setfield $tiddler=<<colourEditTiddler>> text={{{ [tf.palette.get.colour<newColourName>] }}}/>
<$action-setfield $tiddler=<<state>> text="show"/>
\end

\procedure tp-paletteeditor-dropdown-button-hide-actions()
<$action-deletetiddler $tiddler=<<state>>/>
<$action-deletetiddler $tiddler=<<colourEditTiddler>>/>
\end

\procedure tp-colour-preview()
<span
	style.background-color=<<bgColour>>
	style.height="2em"
	style.width="100%"
	style.border-color=<<colour foreground>>
	style.border-width="1px"
	style.border-style="solid"
	style.border-radius="2px"
	style.margin="3px 0"
	class="tc-palette-manager-colour-input"
	style.display="flex"
	style.justify-content="center"
	style.line-height="1.85em"
	style.color=<<contrastcolour colourA=<<colour foreground>> colourB=<<colour background>> target=<<bgColour>>>>
>
<<lingo Preview/Hint>>
</span>
\end

\define delete-colour-index-actions() <$action-setfield $index=<<colourName>>/>
\define palette-manager-colour-row-segment()
\whitespace trim
<$let colourEditTiddler="$:/temp/palette-colours/copy">
<$edit-text
	tiddler=<<colourEditTiddler>>
	index=<<colourName>>
	tag="input"
	placeholder=<<edit-colour-placeholder>>
	default=""
	inputActions=<<tp-paletteeditor-input-actions>>
/>
<br>
<$let rawValue={{{ [{$:/palette}getindex<colourName>] :else[{$:/palette}get[palette-import]getindex<colourName>] }}} colourEditTiddler={{{ [tf.resolve.colour.name<colourName>addprefix[/]addprefix<currentTiddler>addprefix[$:/temp/paletteeditor/input/]] }}} colourRefreshTitle={{{ [<colourEditTiddler>addsuffix[/refresh]] }}}>
<%if [<rawValue>is[colour]then<rawValue>!regexp<tp-colour-filters-regexp>] :else[<rawValue>match[]] %>
<$edit-text
	tiddler={{{ [{$:/palette}getindex<colourName>then{$:/palette}] :else[{$:/palette}get[palette-import]] }}}
	index={{{ [tf.resolve.colour.name<colourName>] }}}
	type="color"
	tag="input"
	class="tc-palette-manager-colour-input"
	inputActions=<<tp-paletteeditor-colour-input-actions>>
/>
<%elseif [<colourName>!prefix[?]] %>
<$let bgColour={{{ [tf.palette.colours.get.colour<colourName>] }}}>
<%if [<bgColour>is[colour]] %>
<<tp-colour-preview>>
<% endif %>
</$let>
<% endif %>
<%if [<rawValue>!is[colour]then<rawValue>!regexp<tp-colour-filters-regexp>subfilter<tf.palette.get.colour.wrapper>is[colour]tf.resolve.colour.name<colourName>!match<colourName>] %>
<$let state={{{ [[$:/state/palettemanager/]addsuffix<currentTiddler>addsuffix[/]addsuffix<colourName>] }}} newColourName={{{ [[$:/temp/palette-colours]getindex<tf.resolve.colour.name.wrapper>is[colour]] :then[tf.resolve.colour.name<colourName>else<colourName>] }}} colourEditTiddler={{{ [[$:/temp/paletteeditor/input/]addsuffix<currentTiddler>addsuffix[/]addsuffix<newColourName>] }}}>
<$reveal state=<<state>> type="nomatch" text="show">
<$button tooltip=<<colour-tooltip show>> aria-label=<<colour-tooltip show>> class="tc-btn-invisible tc-small-gap-right" actions=<<tp-paletteeditor-dropdown-button-show-actions>>>{{$:/core/images/down-arrow}}<$text text=<<newColourName>>/></$button><br>
</$reveal>
<$reveal state=<<state>> type="match" text="show">
<$button tooltip=<<colour-tooltip hide>> aria-label=<<colour-tooltip hide>> class="tc-btn-invisible tc-small-gap-right" actions=<<tp-paletteeditor-dropdown-button-hide-actions>>>{{$:/core/images/up-arrow}}<$text text=<<newColourName>>/></$button><br>
</$reveal>
<$reveal state=<<state>> type="match" text="show">
<$let colourName=<<newColourName>> colourRefreshTitle={{{ [[$:/temp/paletteeditor/input/]addsuffix<currentTiddler>addsuffix[/]addsuffix<newColourName>addsuffix[/refresh]] }}}>
<br>
<$edit-text
	tiddler=<<colourEditTiddler>>
	tag="input"
	placeholder=<<edit-colour-placeholder>>
	default=""
	inputActions=<<tp-paletteeditor-resolved-input-actions>>
	refreshTitle=<<colourRefreshTitle>>
/>
<br/>
<$let rawValue={{{ [{$:/palette}getindex<newColourName>] :else[{$:/palette}get[palette-import]getindex<newColourName>] }}}>
<%if [<rawValue>is[colour]then<rawValue>!regexp<tp-colour-filters-regexp>] :else[<rawValue>match[]] %>
<$edit-text
	index=<<newColourName>>
	type="color"
	tag="input"
	class="tc-palette-manager-colour-input"
	inputActions=<<tp-paletteeditor-colour-input-actions>>
/>
<%elseif [<newColourName>!prefix[?]] %>
<$let bgColour={{{ [tf.palette.colours.get.colour<newColourName>] }}}>
<%if [<bgColour>is[colour]] %>
<<tp-colour-preview>>
<% endif %>
</$let>
<% endif %>
</$let>
<br><br>
</$let>
</$reveal>
</$let>
<% endif %>
</$let>
</$let>
\end

\define palette-manager-colour-row()
\whitespace trim
<tr>
<td>
<span style="float:right;">
<$button tooltip={{$:/language/ControlPanel/Palette/Editor/Delete/Hint}} aria-label={{$:/language/ControlPanel/Palette/Editor/Delete/Hint}} class="tc-btn-invisible" actions=<<delete-colour-index-actions>>>
{{$:/core/images/delete-button}}</$button>
</span>
''<$macrocall $name="describePaletteColour" colour=<<colourName>>/>''<br/>
<$macrocall $name="colourName" $output="text/plain"/>
<%if [<layerTitle>getindex<colourName>] %>
<br/><em><<lingo Customised/Entry>></em>
<%endif%>
</td>
<td>
<<palette-manager-colour-row-segment>>
</td>
</tr>
\end

\define palette-manager-table()
\whitespace trim
<table>
<tbody>
<$set name="colorList" filter="[{$:/state/palettemanager/showexternal}match[yes]]"
   value="[all[shadows+tiddlers]tag[$:/tags/Palette]indexes[]]" emptyValue="[<currentTiddler>indexes[]]">
<$list filter=<<colorList>> variable="colourName"> <<palette-manager-colour-row>> </$list>
</$set>
</tbody>
</table>
\end
\whitespace trim
<$set name="currentTiddler" value={{$:/palette}}>
<$let layerTitle={{{ [function[tf.palette-customisations-layer]] }}}>

<<lingo Prompt>>&#32;<$link to={{$:/palette}}><$macrocall $name="currentTiddler" $output="text/plain"/></$link>

<$list filter="[function[tf.palette-customisations-layer]is[tiddler]]" variable="listItem">
<<lingo Customised/Prompt>>
&#32;
<$button actions="""<$action-deletetiddler $tiddler=<<layerTitle>>/>""">{{$:/language/ControlPanel/Palette/Customisations/Reset/Caption}}</$button>
</$list>

<$list filter="[all[current]is[shadow]is[tiddler]]" variable="listItem">
<<lingo Prompt/Modified>>
&#32;
<$button message="tm-delete-tiddler" param={{$:/palette}}><<lingo Reset/Caption>></$button>
</$list>

<$list filter="[all[current]is[shadow]!is[tiddler]]" variable="listItem">
<<lingo Clone/Prompt>>
</$list>

<$button message="tm-new-tiddler" param={{$:/palette}}><<lingo Clone/Caption>></$button>

<$checkbox tiddler="$:/state/palettemanager/showexternal" field="text" checked="yes" unchecked="no"><span class="tc-small-gap-left"><<lingo Names/External/Show>></span></$checkbox>

<<palette-manager-table>>
</$let>
</$set>
