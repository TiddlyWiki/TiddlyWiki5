title: $:/core/ui/SideBar/Open
tags: $:/tags/SideBar
caption: {{$:/language/SideBar/Open/Caption}}

\whitespace trim
\define lingo-base() $:/language/CloseAll/

\function tf.get-open-tab-drag-state() [<qualify "$:/state/tiddlywiki/dragging">]

\function tf.get-open-tab-animation-duration() [{$:/config/DragAndDrop/animation/duration}multiply[0.8]]

\function tf.get-open-tab-preview() [<tf.get-open-tab-drag-state>get[text]match[yes]then<tf.get-open-tab-drag-state>get[preview-list]]
\function tf.get-open-tab-animate-list() [<tf.get-open-tab-drag-state>get[text]match[yes]then<tf.get-open-tab-drag-state>] :else[<tv-story-list>]

\whitespace trim

\procedure content()
<div class="tc-sidebar-tab-open-item">
<$button message='tm-close-tiddler' tooltip={{$:/language/Buttons/Close/Hint}} aria-label={{$:/language/Buttons/Close/Caption}} class='tc-btn-invisible tc-btn-mini tc-small-gap-right'>{{$:/core/images/close-button}}</$button><$link draggable="no"/>
</div>
\end

<div class="tc-sidebar-tab-open">
<$animatelayout list=<<tf.get-open-tab-animate-list>> enable={{{ [dragging[]] }}} duration=<<tf.get-open-tab-animation-duration>> easing={{$:/config/DragAndDrop/animation/easing}}>
<$list filter="[enlist<tf.get-open-tab-preview>] :else[list<tv-story-list>]" history=<<tv-history-list>> storyview="pop">
<$transclude $variable="make-live-reorderable" tiddler=<<currentTiddler>> list=<<tv-story-list>> content=<<content>> dragState=<<tf.get-open-tab-drag-state>> commit="drop"/>
</$list>
</$animatelayout>
</div>
<$button message='tm-close-all-tiddlers' class='tc-btn-invisible tc-btn-mini'><<lingo Button>></$button>
