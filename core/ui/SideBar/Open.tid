title: $:/core/ui/SideBar/Open
tags: $:/tags/SideBar
caption: {{$:/language/SideBar/Open/Caption}}

\whitespace trim
\define lingo-base() $:/language/CloseAll/

\function tf.get-open-tab-drag-state() [<qualify "$:/state/tiddlywiki/dragging">]

\whitespace trim

\define content()
<div class="tc-sidebar-tab-open-item">
<$button message='tm-close-tiddler' tooltip={{$:/language/Buttons/Close/Hint}} aria-label={{$:/language/Buttons/Close/Caption}} class='tc-btn-invisible tc-btn-mini tc-small-gap-right'>{{$:/core/images/close-button}}</$button><$link draggable="no"/>
</div>
\end

<div class="tc-sidebar-tab-open" style.border-top-style="solid" style.border-top-width="1px" style.border-top-color="transparent">
<$animatelayout duration={{$:/config/DragAndDrop/animation/duration}} easing={{$:/config/DragAndDrop/animation/easing}}>
<$list filter="[list<tv-story-list>]" history=<<tv-history-list>> storyview="pop">
<$transclude $variable="make-live-reorderable" tiddler=<<currentTiddler>> list=<<tv-story-list>> content=<<content>> dragState=<<tf.get-open-tab-drag-state>>/>
</$list>
</$animatelayout>
</div>
<$button message='tm-close-all-tiddlers' class='tc-btn-invisible tc-btn-mini'><<lingo Button>></$button>
