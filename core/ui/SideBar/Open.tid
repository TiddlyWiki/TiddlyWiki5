title: $:/core/ui/SideBar/Open
tags: $:/tags/SideBar
caption: {{$:/language/SideBar/Open/Caption}}

\whitespace trim
\define lingo-base() $:/language/CloseAll/

\function tf.get-open-tab-drag-state() [<qualify "$:/state/tiddlywiki/dragging">]

\function tf.get-open-tab-animation-duration() [{$:/config/DragAndDrop/animation/duration}multiply[0.8]]

\whitespace trim

\procedure content()
<div class="tc-sidebar-tab-open-item">
<$button message="tm-close-tiddler" tooltip={{$:/language/Buttons/Close/Hint}} aria-label={{$:/language/Buttons/Close/Caption}} class="tc-btn-invisible tc-btn-mini tc-small-gap-right">{{$:/core/images/close-button}}</$button><$link draggable="no"/>
</div>
\end

<div class="tc-sidebar-tab-open">
<$transclude $variable="make-live-reorderable-list" $mode="inline" list=<<tv-story-list>> content=<<content>> history=<<tv-history-list>> storyview="pop" duration=<<tf.get-open-tab-animation-duration>> dragState=<<tf.get-open-tab-drag-state>> commit="drop"/>
</div>
<$button message="tm-close-all-tiddlers" class="tc-btn-invisible tc-btn-mini"><<lingo Button>></$button>
