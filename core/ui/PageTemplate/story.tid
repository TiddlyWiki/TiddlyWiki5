title: $:/core/ui/PageTemplate/story
tags: $:/tags/PageTemplate

\procedure content()
\whitespace trim
{{||$:/core/ui/StoryTiddlerTemplate}}
\end

\function tf.get-story-drag-state() [<qualify "$:/state/tiddlywiki/dragging">]

\whitespace trim

<section class={{{ [all[shadows+tiddlers]tag[$:/tags/ClassFilters/StoryRiver]!is[draft]] :map:flat[subfilter{!!text}] tc-story-river :and[join[ ]] }}} role="main">

<$transclude $variable="make-live-reorder-backstop" list="$:/StoryList" dragState=<<tf.get-story-drag-state>>/>

<section class="story-backdrop">

<$list filter="[all[shadows+tiddlers]tag[$:/tags/AboveStory]!has[draft.of]]">

<$transclude/>

</$list>

</section>

<$animatelayout list="$:/StoryList" enable={{{ [dragging[]] }}} duration={{$:/config/DragAndDrop/animation/duration}} easing={{$:/config/DragAndDrop/animation/easing}}>

<$list filter="[list[$:/StoryList]]" history="$:/HistoryList" storyview={{$:/view}} emptyMessage={{$:/config/EmptyStoryMessage}}>

<$transclude $variable="make-live-reorderable" $mode="inline" tiddler=<<currentTiddler>> enable={{$:/config/story/dragndrop/enable}} list="$:/StoryList" content=<<content>> dragState=<<tf.get-story-drag-state>>/>

</$list>

</$animatelayout>

<section class="story-frontdrop">

<$list filter="[all[shadows+tiddlers]tag[$:/tags/BelowStory]!has[draft.of]]">

<$transclude/>

</$list>

</section>

</section>
