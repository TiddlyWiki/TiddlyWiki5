title: $:/core/ui/PageTemplate/story
tags: $:/tags/PageTemplate

\procedure content()
\whitespace trim
{{||$:/core/ui/StoryTiddlerTemplate}}
\end

\function tf.get-story-drag-state() [<qualify "$:/state/tiddlywiki/dragging">]

\whitespace trim

<section class={{{ [all[shadows+tiddlers]tag[$:/tags/ClassFilters/StoryRiver]!is[draft]] :map:flat[subfilter{!!text}] tc-story-river :and[join[ ]] }}} role="main">

<section class="story-backdrop">

<$list filter="[all[shadows+tiddlers]tag[$:/tags/AboveStory]!has[draft.of]]">

<$transclude/>

</$list>

</section>

<$transclude $variable="make-live-reorderable-list"
	$mode="inline"
	list="$:/StoryList"
	content=<<content>>
	enable={{$:/config/story/dragndrop/enable}}
	animate={{{ [{$:/config/StoryRiver/masonry}match[yes]then[yes]] }}}
	history="$:/HistoryList"
	storyview={{$:/view}}
	emptyMessage={{$:/config/EmptyStoryMessage}}
	dragState=<<tf.get-story-drag-state>>
	emptyHeight="160px"
/>

<section class="story-frontdrop">

<$list filter="[all[shadows+tiddlers]tag[$:/tags/BelowStory]!has[draft.of]]">

<$transclude/>

</$list>

</section>

</section>
