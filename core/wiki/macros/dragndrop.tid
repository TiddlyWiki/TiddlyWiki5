title: $:/core/wiki/macros/dragndrop
tags: $:/tags/Global
code-body: yes

\procedure live-reorder-drag-start-actions()
<$let
	alreadyDragging={{{ [<dragState>get[text]match[yes]then[yes]] :else[[no]] }}}
>
	<%if [<alreadyDragging>match[no]] %>
		<$action-setfield
			$tiddler=<<dragState>>
			tags="$:/tags/dragState"
			text="yes"
			drag-tiddler=<<tiddler>>
			from-list=<<list>>
			start-index={{{ [list<list>allbefore<tiddler>count[]] }}}
			preview-list={{{ [<tf.lr.is-deferred>match[yes]then<list>get[list]] }}}
			start-list={{{ [<list>get[list]] }}}
			commit=<<commit>>
		/>
	<% endif %>
</$let>
\end

\procedure live-reorder-before-drag-enter-actions()
<$let
	draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
	currentPrevious={{{ [enlist<tf.lr.get-order>before<tiddler>] }}}
>
	<%if [<draggedTiddler>!match<tiddler>] %>
		<%if [<draggedTiddler>!match<currentPrevious>] %>
			<$action-listops
				$tiddler=<<tf.lr.get-order-tiddler>>
				$field=<<tf.lr.get-order-field>>
				$subfilter="+[insertbefore<draggedTiddler>,<tiddler>]"
			/>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-after-drag-enter-actions()
<$let
	draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
	currentNext={{{ [enlist<tf.lr.get-order>after<tiddler>] }}}
>
	<%if [<draggedTiddler>!match<tiddler>] %>
		<%if [<draggedTiddler>!match<currentNext>] %>
			<$action-listops
				$tiddler=<<tf.lr.get-order-tiddler>>
				$field=<<tf.lr.get-order-field>>
				$subfilter="+[insertafter<draggedTiddler>,<tiddler>]"
			/>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-drop-actions()
<%if [<tf.lr.is-deferred>match[yes]] %>
	<$action-setfield
		$tiddler=<<list>>
		$field="list"
		$value={{{ [<dragState>get[preview-list]] }}}
	/>
<% endif %>
<$action-setfield
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
	text="yes"
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
<<dropActions>>
\end

\procedure live-reorder-drag-end-actions()
<%if [<dragState>addsuffix[/drag-handled]is[missing]] %>
	<%if [<tf.lr.is-deferred>match[no]] %>
		<$let
			fromList={{{ [<dragState>get[from-list]] }}}
			draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
			startIndex={{{ [<dragState>get[start-index]] }}}
			anchorTiddler={{{ [list<fromList>!match<draggedTiddler>zth<startIndex>] }}}
		>
			<%if [<anchorTiddler>!is[blank]] %>
				<$action-listops
					$tiddler=<<fromList>>
					$subfilter="+[insertbefore<draggedTiddler>,<anchorTiddler>]"
				/>
			<% else %>
				<$action-listops
					$tiddler=<<fromList>>
					$subfilter="-[<draggedTiddler>] [<draggedTiddler>]"
				/>
			<% endif %>
		</$let>
	<% endif %>
<% endif %>
<$action-deletetiddler
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
\end

\procedure live-reorder-revert-actions()
<$list filter="[all[tiddlers]tag[$:/tags/dragState]]" variable="revertState">
	<$let
		startList={{{ [<revertState>get[start-list]] }}}
		fromList={{{ [<revertState>get[from-list]] }}}
		revertDeferred={{{ [<revertState>get[commit]match[drop]then[yes]] :else[[no]] }}}
	>
		<%if [<revertDeferred>match[yes]] %>
			<%if [<revertState>get[preview-list]!match<startList>] %>
				<$action-setfield
					$tiddler=<<revertState>>
					$field="preview-list"
					$value=<<startList>>
				/>
			<% endif %>
		<% else %>
			<%if [<fromList>get[list]!match<startList>] %>
				<$action-setfield
					$tiddler=<<fromList>>
					$field="list"
					$value=<<startList>>
				/>
			<% endif %>
		<% endif %>
	</$let>
</$list>
\end

\function tf.lr.is-dragging() [<dragState>get[text]match[yes]then[yes]] :else[[no]]

\function tf.lr.is-deferred() [<commit>match[drop]then[yes]] :else[[no]]

\function tf.lr.get-order-tiddler() [<tf.lr.is-deferred>match[yes]then<dragState>] :else[<list>]
\function tf.lr.get-order-field() [<tf.lr.is-deferred>match[yes]then[preview-list]] :else[[list]]
\function tf.lr.get-order() [<tf.lr.get-order-tiddler>get<tf.lr.get-order-field>]

\function tf.lr.is-ghost() [<tf.lr.is-dragging>match[yes]then<dragState>get[drag-tiddler]match<tiddler>then[yes]] :else[[no]]
\function tf.lr.show-drop-target() [{$:/config/DragAndDrop/show-drop-target}match[yes]then[yes]] :else[[no]]
\function tf.lr.is-drop-target() [<tf.lr.is-ghost>match[yes]then<tf.lr.show-drop-target>] :else[[no]]
\function tf.lr.is-vertical() [<direction>match[vertical]then[yes]] :else[[no]]
\function tf.lr.get-before-top() [<tf.lr.is-vertical>match[yes]then[0]] :else[[0]]
\function tf.lr.get-before-left() [[0]]
\function tf.lr.get-before-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-before-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]
\function tf.lr.get-after-top() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[0]]
\function tf.lr.get-after-left() [<tf.lr.is-vertical>match[yes]then[0]] :else[[50%]]
\function tf.lr.get-after-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-after-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]

\function tf.lr.get-item-class() tc-live-reorderable [<tf.lr.is-ghost>match[yes]then[tc-live-reorderable-ghost]] [<tf.lr.is-drop-target>match[yes]then[tc-live-reorderable-drop-target]] [<class>] :and[join[ ]]

\function tf.lr.get-preview() [<tf.lr.is-deferred>match[yes]then<tf.lr.is-dragging>match[yes]then<dragState>get[preview-list]]
\function tf.lr.get-animate-list() [<tf.lr.get-preview>!is[blank]then<dragState>] :else[<list>]
\function tf.lr.get-duration() [<duration>!is[blank]then<duration>] :else[{$:/config/DragAndDrop/animation/duration}]
\function tf.lr.get-easing() [<easing>!is[blank]then<easing>] :else[{$:/config/DragAndDrop/animation/easing}]

\procedure make-live-reorder-backstop(list:"",dragState:"$:/state/tiddlywiki/live-reorder",dropActions:"",commit:"live")
\whitespace trim
<%if [<tf.lr.is-dragging>match[yes]] %>
	<$droppable
		tag="div"
		class="tc-live-reorder-backstop"
		actions=<<live-reorder-drop-actions>>
	/>
<% endif %>
\end

\procedure make-live-reorderable-list(list:"",content:"",class:"",enable:"yes",dropActions:"",history:"",storyview:"",emptyMessage:"",duration:"",easing:"",dragState:"$:/state/tiddlywiki/live-reorder",direction:"vertical",itemDisplay:"flow-root",ghostOpacity:"0.3",styleZIndex:"501",commit:"live")
\whitespace trim
<$transclude $variable="make-live-reorder-backstop" $mode="inline" list=<<list>> dragState=<<dragState>> dropActions=<<dropActions>> commit=<<commit>>/>
<$animatelayout list=<<tf.lr.get-animate-list>> enable={{{ [dragging[]] }}} duration=<<tf.lr.get-duration>> easing=<<tf.lr.get-easing>>>
<$list filter="[enlist<tf.lr.get-preview>] :else[list<list>]" history=<<history>> storyview=<<storyview>> emptyMessage=<<emptyMessage>>>
<$transclude $variable="make-live-reorderable" $mode="inline" tiddler=<<currentTiddler>> class=<<class>> content=<<content>> list=<<list>> enable=<<enable>> dropActions=<<dropActions>> dragState=<<dragState>> direction=<<direction>> itemDisplay=<<itemDisplay>> ghostOpacity=<<ghostOpacity>> styleZIndex=<<styleZIndex>> commit=<<commit>>/>
</$list>
</$animatelayout>
\end

\procedure make-live-reorderable(tiddler:"",class:"",content:"",list:"",enable:"yes",dropActions:"",history:"",dragState:"$:/state/tiddlywiki/live-reorder",direction:"vertical",itemDisplay:"flow-root",ghostOpacity:"0.3",styleZIndex:"501",commit:"live")
\whitespace trim
\rules except dash
<$draggable
	enable=<<enable>>
	tiddler=<<tiddler>>
	startactions=<<live-reorder-drag-start-actions>>
	endactions=<<live-reorder-drag-end-actions>>
	class=<<tf.lr.get-item-class>>
	data-animate-key=<<tiddler>>
	style.display=<<itemDisplay>>
	style.position="relative"
	--tc-live-reorder-ghost-opacity=<<ghostOpacity>>
>
	<$set name="tv-enable-drag-and-drop" value={{{ [<enable>match[yes]then[no]] :else[<tv-enable-drag-and-drop>] }}}>
		<<content>>
	</$set>
	<%if [<tf.lr.is-dragging>match[yes]] %>
		<$droppable
			class="tc-live-reorderable-drop-before"
			actions=<<live-reorder-drop-actions>>
			dragEnterActions=<<live-reorder-before-drag-enter-actions>>
		>
			<div
				class="tc-live-reorderable-drop-placeholder"
				data-animate-hold="yes"
				style.position="absolute"
				style.top=<<tf.lr.get-before-top>>
				style.left=<<tf.lr.get-before-left>>
				style.width=<<tf.lr.get-before-width>>
				style.height=<<tf.lr.get-before-height>>
				style.z-index=<<styleZIndex>>
			/>
		</$droppable>
		<$droppable
			class="tc-live-reorderable-drop-after"
			actions=<<live-reorder-drop-actions>>
			dragEnterActions=<<live-reorder-after-drag-enter-actions>>
		>
			<div
				class="tc-live-reorderable-drop-placeholder"
				data-animate-hold="yes"
				style.position="absolute"
				style.top=<<tf.lr.get-after-top>>
				style.left=<<tf.lr.get-after-left>>
				style.width=<<tf.lr.get-after-width>>
				style.height=<<tf.lr.get-after-height>>
				style.z-index=<<styleZIndex>>
			/>
		</$droppable>
	<% endif %>
</$draggable>
\end
