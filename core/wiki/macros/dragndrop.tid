title: $:/core/wiki/macros/dragndrop
tags: $:/tags/Global
code-body: yes

\procedure live-reorder-begin-actions(beginFilter,beginTransfer:"move")
<$action-setfield
	$tiddler=<<dragState>>
	tags="$:/tags/dragState"
	text="yes"
	source-list=<<list>>
	from-list=<<list>>
	preview-list={{{ [<tf.lr.is-deferred>match[yes]then<list>get[list]] }}}
	start-list={{{ [<list>get[list]] }}}
	commit=<<commit>>
	transfer=<<beginTransfer>>
/>
<$action-listops
	$tiddler=<<dragState>>
	$field="drag-titles"
	$filter=<<beginFilter>>
/>
\end

\procedure live-reorder-drag-start-actions()
<$let
	alreadyDragging={{{ [<dragState>get[text]match[yes]then[yes]] :else[[no]] }}}
>
	<%if [<alreadyDragging>match[no]] %>
		<$transclude $variable="live-reorder-begin-actions" beginFilter="[<tiddler>]" beginTransfer=<<transfer>>/>
	<% endif %>
</$let>
\end

\procedure live-reorder-adopt-actions()
<$let recordTitles={{{ [[$:/state/dragging]get[list]] }}}>
	<%if [<tf.lr.accepts-drops>match[yes]] %>
		<%if [<tf.lr.is-dragging>match[no]] %>
			<%if [<recordTitles>!is[blank]] %>
				<$transclude $variable="live-reorder-begin-actions" beginFilter="[enlist<recordTitles>]"/>
			<% endif %>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-abandon-actions()
<$list filter="[all[tiddlers]tag[$:/tags/dragState]]" variable="abandonState">
	<$let dragState=<<abandonState>>>
		<%if [<abandonState>addsuffix[/drag-handled]is[missing]] %>
			<<live-reorder-restore-actions>>
		<% endif %>
	</$let>
	<$action-deletetiddler
		$tiddler={{{ [<abandonState>addsuffix[/drag-handled]] }}}
	/>
	<$action-deletetiddler
		$tiddler=<<abandonState>>
	/>
</$list>
\end

\procedure live-reorder-carry-actions()
<$let
	cameFrom={{{ [<dragState>get[from-list]] }}}
	sourceList={{{ [<dragState>get[source-list]] }}}
	keepsIt={{{ [<dragState>get[transfer]match[copy]then<cameFrom>match<sourceList>then[yes]] :else[[no]] }}}
>
	<%if [<list>!match<cameFrom>] %>
		<%if [<cameFrom>!is[blank]] %>
			<%if [<keepsIt>match[no]] %>
				<$action-listops
					$tiddler=<<cameFrom>>
					$subfilter="-[enlist<tf.lr.get-titles>]"
				/>
			<% endif %>
		<% endif %>
		<$action-setfield
			$tiddler=<<dragState>>
			from-list=<<list>>
		/>
	<% endif %>
</$let>
\end

\procedure live-reorder-before-drag-enter-actions()
<<live-reorder-adopt-actions>>
<$let
	currentPrevious={{{ [enlist<tf.lr.get-order>before<tiddler>] }}}
	lastDragged={{{ [enlist<tf.lr.get-titles>last[]] }}}
>
	<%if [enlist<tf.lr.get-titles>match<tiddler>count[]match[0]] %>
		<<live-reorder-carry-actions>>
		<%if [<lastDragged>!match<currentPrevious>] %>
			<$list filter="[enlist<tf.lr.get-titles>]" variable="lrTitle">
				<$action-listops
					$tiddler=<<tf.lr.get-order-tiddler>>
					$field=<<tf.lr.get-order-field>>
					$subfilter="+[insertbefore<lrTitle>,<tiddler>]"
				/>
			</$list>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-after-drag-enter-actions()
<<live-reorder-adopt-actions>>
<$let
	currentNext={{{ [enlist<tf.lr.get-order>after<tiddler>] }}}
	firstDragged={{{ [enlist<tf.lr.get-titles>first[]] }}}
>
	<%if [enlist<tf.lr.get-titles>match<tiddler>count[]match[0]] %>
		<<live-reorder-carry-actions>>
		<%if [<firstDragged>!match<currentNext>] %>
			<$list filter="[enlist<tf.lr.get-titles>reverse[]]" variable="lrTitle">
				<$action-listops
					$tiddler=<<tf.lr.get-order-tiddler>>
					$field=<<tf.lr.get-order-field>>
					$subfilter="+[insertafter<lrTitle>,<tiddler>]"
				/>
			</$list>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-drop-actions()
<%if [<tf.lr.is-deferred>match[yes]] %>
	<$action-setfield
		$tiddler=<<list>>
		$field="list"
		$value={{{ [<dragState>get[preview-list]] }}}
	/>
<% endif %>
<$action-setfield
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
	text="yes"
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
<<dropActions>>
\end

\procedure live-reorder-before-drop-actions()
<%if [<tf.lr.is-dragging>match[yes]] %>
	<<live-reorder-drop-actions>>
<% else %>
	<%if [<actionTiddler>!match<tiddler>] %>
		<$action-listops
			$tiddler=<<list>>
			$subfilter="+[insertbefore<actionTiddler>,<tiddler>]"
		/>
		<<dropActions>>
	<% endif %>
<% endif %>
\end

\procedure live-reorder-after-drop-actions()
<%if [<tf.lr.is-dragging>match[yes]] %>
	<<live-reorder-drop-actions>>
<% else %>
	<%if [<actionTiddler>!match<tiddler>] %>
		<$action-listops
			$tiddler=<<list>>
			$subfilter="+[insertafter<actionTiddler>,<tiddler>]"
		/>
		<<dropActions>>
	<% endif %>
<% endif %>
\end

\procedure live-reorder-empty-drag-enter-actions()
<<live-reorder-adopt-actions>>
<$let
	itemsHere={{{ [enlist<tf.lr.get-order>count[]] }}}
>
	<%if [<list>!is[blank]] %>
		<%if [enlist<tf.lr.get-titles>count[]!match[0]] %>
			<%if [<itemsHere>match[0]] %>
				<<live-reorder-carry-actions>>
				<$list filter="[enlist<tf.lr.get-titles>]" variable="lrTitle">
					<$action-listops
						$tiddler=<<tf.lr.get-order-tiddler>>
						$field=<<tf.lr.get-order-field>>
						$subfilter="-[<lrTitle>] [<lrTitle>]"
					/>
				</$list>
			<% endif %>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-restore-actions()
<$let
	sourceList={{{ [<dragState>get[source-list]] }}}
	holdsIt={{{ [<dragState>get[from-list]] }}}
>
	<%if [<holdsIt>!match<sourceList>] %>
		<$action-listops
			$tiddler=<<holdsIt>>
			$subfilter="-[enlist<tf.lr.get-titles>]"
		/>
	<% endif %>
	<$action-setfield
		$tiddler=<<sourceList>>
		$field="list"
		$value={{{ [<dragState>get[start-list]] }}}
	/>
	<$action-setfield
		$tiddler=<<dragState>>
		from-list=<<sourceList>>
	/>
</$let>
\end

\procedure live-reorder-drag-end-actions()
<%if [<dragState>addsuffix[/drag-handled]is[missing]] %>
	<%if [<tf.lr.is-deferred>match[no]] %>
		<<live-reorder-restore-actions>>
	<% endif %>
<% endif %>
<$action-deletetiddler
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
\end

\procedure live-reorder-revert-actions()
<$list filter="[all[tiddlers]tag[$:/tags/dragState]]" variable="revertState">
	<$let
		startList={{{ [<revertState>get[start-list]] }}}
		sourceList={{{ [<revertState>get[source-list]] }}}
		holdsIt={{{ [<revertState>get[from-list]] }}}
		revertDeferred={{{ [<revertState>get[commit]match[drop]then[yes]] :else[[no]] }}}
	>
		<%if [<revertDeferred>match[yes]] %>
			<%if [<revertState>get[preview-list]!match<startList>] %>
				<$action-setfield
					$tiddler=<<revertState>>
					$field="preview-list"
					$value=<<startList>>
				/>
			<% endif %>
		<% else %>
			<%if [<holdsIt>!match<sourceList>] %>
				<$let dragState=<<revertState>>>
					<<live-reorder-restore-actions>>
				</$let>
			<% else %>
				<%if [<sourceList>get[list]!match<startList>] %>
					<$action-setfield
						$tiddler=<<sourceList>>
						$field="list"
						$value=<<startList>>
					/>
				<% endif %>
			<% endif %>
		<% endif %>
	</$let>
</$list>
\end

\function tf.lr.is-dragging() [<dragState>get[text]match[yes]then[yes]] :else[[no]]

\function tf.lr.is-deferred() [<commit>match[drop]then[yes]] :else[[no]]

\function tf.lr.get-order-tiddler() [<tf.lr.is-deferred>match[yes]then<dragState>] :else[<list>]
\function tf.lr.get-order-field() [<tf.lr.is-deferred>match[yes]then[preview-list]] :else[[list]]
\function tf.lr.get-order() [<tf.lr.get-order-tiddler>get<tf.lr.get-order-field>]

\function tf.lr.get-record-titles() [<tf.lr.accepts-drops>match[yes]then[$:/state/dragging]get[list]]
\function tf.lr.get-titles() [<dragState>get[drag-titles]] :else[<tf.lr.get-record-titles>]
\function tf.lr.is-multi() [enlist<tf.lr.get-titles>butfirst[]count[]!match[0]then[yes]] :else[[no]]
\function tf.lr.get-drop-target-offset() [<tf.lr.is-multi>match[yes]then[0px]] :else[<dropTargetOffset>]
\function tf.lr.is-ghost() [enlist<tf.lr.get-titles>match<tiddler>then[yes]] :else[[no]]
\function tf.lr.show-drop-target() [{$:/config/DragAndDrop/show-drop-target}match[yes]then[yes]] :else[[no]]
\function tf.lr.is-drop-target() [<tf.lr.is-ghost>match[yes]then<tf.lr.show-drop-target>] :else[[no]]
\function tf.lr.get-enable() [<enable>!is[blank]then<enable>] :else[<tv-enable-drag-and-drop>match[no]then[no]] :else[[yes]]
\function tf.lr.get-drag-state() [<group>!is[blank]then[$:/state/tiddlywiki/live-reorder/]addsuffix<group>] :else[<dragState>]
\function tf.lr.accepts-drops() [<acceptDrops>match[yes]then[yes]] :else[[no]]
\function tf.lr.show-targets() [<tf.lr.is-dragging>match[yes]then[yes]] :else[<tf.lr.accepts-drops>]

\function tf.lr.is-vertical() [<direction>match[vertical]then[yes]] :else[[no]]
\function tf.lr.get-before-top() [<tf.lr.is-vertical>match[yes]then[0]] :else[[0]]
\function tf.lr.get-before-left() [[0]]
\function tf.lr.get-before-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-before-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]
\function tf.lr.get-after-top() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[0]]
\function tf.lr.get-after-left() [<tf.lr.is-vertical>match[yes]then[0]] :else[[50%]]
\function tf.lr.get-after-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-after-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]

\function tf.lr.get-item-class() tc-live-reorderable [<tf.lr.is-ghost>match[yes]then[tc-live-reorderable-ghost]] [<tf.lr.is-drop-target>match[yes]then[tc-live-reorderable-drop-target]] [<class>] :and[join[ ]]

\function tf.lr.get-preview() [<tf.lr.is-deferred>match[yes]then<tf.lr.is-dragging>match[yes]then<dragState>get[preview-list]]
\function tf.lr.get-animate-list() [<tf.lr.get-preview>!is[blank]then<dragState>] :else[<list>]
\function tf.lr.get-duration() [<duration>!is[blank]then<duration>] :else[{$:/config/DragAndDrop/animation/duration}]
\function tf.lr.get-easing() [<easing>!is[blank]then<easing>] :else[{$:/config/DragAndDrop/animation/easing}]

\procedure make-live-reorder-backstop(list:"",enable:"",group:"",dragState:"$:/state/tiddlywiki/live-reorder",dropActions:"",commit:"live")
\whitespace trim
<$let dragState=<<tf.lr.get-drag-state>>>
	<%if [<tf.lr.is-dragging>match[yes]] %>
		<$droppable
			tag="div"
			enable=<<tf.lr.get-enable>>
			class="tc-live-reorder-backstop"
			actions=<<live-reorder-drop-actions>>
			dragEnterActions=<<live-reorder-empty-drag-enter-actions>>
		/>
	<% endif %>
</$let>
\end

\procedure make-live-reorderable-list(list:"",content:"",class:"",enable:"",acceptDrops:"no",group:"",transfer:"move",dropTargetInset:"",dropTargetOffset:"",emptyHeight:"",scale:"no",dropActions:"",history:"",storyview:"",emptyMessage:"",duration:"",easing:"",dragState:"$:/state/tiddlywiki/live-reorder",direction:"vertical",itemDisplay:"flow-root",ghostOpacity:"0.3",styleZIndex:"501",commit:"live")
\whitespace trim
<$let dragState=<<tf.lr.get-drag-state>>>
	<$transclude $variable="make-live-reorder-backstop"
		$mode="inline"
		list=<<list>>
		enable=<<enable>>
		group=<<group>>
		dragState=<<dragState>>
		dropActions=<<dropActions>>
		commit=<<commit>>
	/>
	<$animatelayout
		list=<<tf.lr.get-animate-list>>
		enable={{{ [dragging[]] }}}
		duration=<<tf.lr.get-duration>>
		easing=<<tf.lr.get-easing>>
		scale=<<scale>>
	>
		<$list filter="[enlist<tf.lr.get-preview>] :else[list<list>]" history=<<history>> storyview=<<storyview>> emptyMessage=<<emptyMessage>>>
			<$transclude $variable="make-live-reorderable"
				$mode="inline"
				tiddler=<<currentTiddler>>
				class=<<class>>
				content=<<content>>
				list=<<list>>
				enable=<<enable>>
				acceptDrops=<<acceptDrops>>
				group=<<group>>
				transfer=<<transfer>>
				dropTargetInset=<<dropTargetInset>>
				dropTargetOffset=<<dropTargetOffset>>
				dropActions=<<dropActions>>
				dragState=<<dragState>>
				direction=<<direction>>
				itemDisplay=<<itemDisplay>>
				ghostOpacity=<<ghostOpacity>>
				styleZIndex=<<styleZIndex>>
				commit=<<commit>>
			/>
		</$list>
	</$animatelayout>
	<$list filter="[enlist<tf.lr.get-preview>] :else[list<list>] +[count[]match[0]]" variable="tf.lr.empty">
		<div class="tc-live-reorderable-empty-slot" style.min-height=<<emptyHeight>>/>
	</$list>
</$let>
\end

\procedure make-live-reorderable(tiddler:"",class:"",content:"",list:"",enable:"",acceptDrops:"no",group:"",transfer:"move",dropTargetInset:"",dropTargetOffset:"",dropActions:"",dragState:"$:/state/tiddlywiki/live-reorder",direction:"vertical",itemDisplay:"flow-root",ghostOpacity:"0.3",styleZIndex:"501",commit:"live")
\whitespace trim
\rules except dash
<$let dragState=<<tf.lr.get-drag-state>>>
	<$draggable
		enable=<<tf.lr.get-enable>>
		tiddler=<<tiddler>>
		startactions=<<live-reorder-drag-start-actions>>
		endactions=<<live-reorder-drag-end-actions>>
		class=<<tf.lr.get-item-class>>
		data-animate-key=<<tiddler>>
		style.display=<<itemDisplay>>
		style.position="relative"
		--tc-live-reorder-ghost-opacity=<<ghostOpacity>>
		--tc-live-reorder-drop-target-bottom=<<dropTargetInset>>
		--tc-live-reorder-drop-target-offset=<<tf.lr.get-drop-target-offset>>
	>
		<$set name="tv-enable-drag-and-drop" value={{{ [<tf.lr.get-enable>match[yes]then[no]] :else[<tv-enable-drag-and-drop>] }}}>
			<<content>>
		</$set>
		<%if [<tf.lr.show-targets>match[yes]] %>
			<$droppable
				enable=<<tf.lr.get-enable>>
				class="tc-live-reorderable-drop-before"
				actions=<<live-reorder-before-drop-actions>>
				dragEnterActions=<<live-reorder-before-drag-enter-actions>>
			>
				<div
					class="tc-live-reorderable-drop-placeholder"
					data-animate-hold="yes"
					style.position="absolute"
					style.top=<<tf.lr.get-before-top>>
					style.left=<<tf.lr.get-before-left>>
					style.width=<<tf.lr.get-before-width>>
					style.height=<<tf.lr.get-before-height>>
					style.z-index=<<styleZIndex>>
				/>
			</$droppable>
			<$droppable
				enable=<<tf.lr.get-enable>>
				class="tc-live-reorderable-drop-after"
				actions=<<live-reorder-after-drop-actions>>
				dragEnterActions=<<live-reorder-after-drag-enter-actions>>
			>
				<div
					class="tc-live-reorderable-drop-placeholder"
					data-animate-hold="yes"
					style.position="absolute"
					style.top=<<tf.lr.get-after-top>>
					style.left=<<tf.lr.get-after-left>>
					style.width=<<tf.lr.get-after-width>>
					style.height=<<tf.lr.get-after-height>>
					style.z-index=<<styleZIndex>>
				/>
			</$droppable>
		<% endif %>
	</$draggable>
</$let>
\end
