title: $:/core/wiki/macros/dragndrop
tags: $:/tags/Global
code-body: yes

\procedure live-reorder-drag-start-actions()
<$let
	alreadyDragging={{{ [<dragState>get[text]match[yes]then[yes]] :else[[no]] }}}
>
	<%if [<alreadyDragging>match[no]] %>
		<$action-setfield
			$tiddler=<<dragState>>
			tags="$:/tags/dragState"
			text="yes"
			drag-tiddler=<<tiddler>>
			from-list=<<list>>
			start-index={{{ [list<list>allbefore<tiddler>count[]] }}}
		/>
	<% endif %>
</$let>
\end

\procedure live-reorder-before-drag-enter-actions()
<$let
	draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
	currentPrevious={{{ [list<list>before<tiddler>] }}}
>
	<%if [<draggedTiddler>!match<tiddler>] %>
		<%if [<draggedTiddler>!match<currentPrevious>] %>
			<$action-listops
				$tiddler=<<list>>
				$subfilter="+[insertbefore<draggedTiddler>,<tiddler>]"
			/>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-after-drag-enter-actions()
<$let
	draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
	currentNext={{{ [list<list>after<tiddler>] }}}
>
	<%if [<draggedTiddler>!match<tiddler>] %>
		<%if [<draggedTiddler>!match<currentNext>] %>
			<$action-listops
				$tiddler=<<list>>
				$subfilter="+[insertafter<draggedTiddler>,<tiddler>]"
			/>
		<% endif %>
	<% endif %>
</$let>
\end

\procedure live-reorder-drop-actions()
<$action-setfield
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
	text="yes"
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
<<dropActions>>
\end

\procedure live-reorder-drag-end-actions()
<%if [<dragState>addsuffix[/drag-handled]is[missing]] %>
	<$let
		fromList={{{ [<dragState>get[from-list]] }}}
		draggedTiddler={{{ [<dragState>get[drag-tiddler]] }}}
		startIndex={{{ [<dragState>get[start-index]] }}}
		anchorTiddler={{{ [list<fromList>!match<draggedTiddler>zth<startIndex>] }}}
	>
		<%if [<anchorTiddler>!is[blank]] %>
			<$action-listops
				$tiddler=<<fromList>>
				$subfilter="+[insertbefore<draggedTiddler>,<anchorTiddler>]"
			/>
		<% else %>
			<$action-listops
				$tiddler=<<fromList>>
				$subfilter="-[<draggedTiddler>] [<draggedTiddler>]"
			/>
		<% endif %>
	</$let>
<% endif %>
<$action-deletetiddler
	$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
/>
<$action-deletetiddler
	$tiddler=<<dragState>>
/>
\end

\function tf.lr.is-dragging() [<dragState>get[text]match[yes]then[yes]] :else[[no]]
\function tf.lr.is-ghost() [<tf.lr.is-dragging>match[yes]then<dragState>get[drag-tiddler]match<tiddler>then[yes]] :else[[no]]
\function tf.lr.get-opacity() [<tf.lr.is-ghost>match[yes]then<ghostOpacity>] :else[[]]
\function tf.lr.is-vertical() [<direction>match[vertical]then[yes]] :else[[no]]
\function tf.lr.get-before-top() [<tf.lr.is-vertical>match[yes]then[0]] :else[[0]]
\function tf.lr.get-before-left() [[0]]
\function tf.lr.get-before-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-before-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]
\function tf.lr.get-after-top() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[0]]
\function tf.lr.get-after-left() [<tf.lr.is-vertical>match[yes]then[0]] :else[[50%]]
\function tf.lr.get-after-width() [<tf.lr.is-vertical>match[yes]then[100%]] :else[[50%]]
\function tf.lr.get-after-height() [<tf.lr.is-vertical>match[yes]then[50%]] :else[[100%]]

\function tf.lr.get-item-class() tc-live-reorderable [<tf.lr.is-ghost>match[yes]then[tc-live-reorderable-ghost]] [<class>] :and[join[ ]]

\procedure make-live-reorderable(tiddler:"",class:"",content:"",list:"",enable:"yes",dropActions:"",history:"",dragState:"$:/state/tiddlywiki/live-reorder",direction:"vertical",itemDisplay:"flow-root",ghostOpacity:"0.3",styleZIndex:"501")
\whitespace trim
<$tiddler tiddler=<<tiddler>>>
	<$draggable
		enable=<<enable>>
		tiddler=<<tiddler>>
		startactions=<<live-reorder-drag-start-actions>>
		endactions=<<live-reorder-drag-end-actions>>
		class=<<tf.lr.get-item-class>>
		data-animate-key=<<tiddler>>
		style.display=<<itemDisplay>>
		style.position="relative"
		style.opacity=<<tf.lr.get-opacity>>
	>
		<$set name="tv-enable-drag-and-drop" value={{{ [<enable>match[yes]then[no]] :else[<tv-enable-drag-and-drop>] }}}>
			<<content>>
		</$set>
		<%if [<tf.lr.is-dragging>match[yes]] %>
			<$droppable
				class="tc-live-reorderable-drop-before"
				actions=<<live-reorder-drop-actions>>
				dragEnterActions=<<live-reorder-before-drag-enter-actions>>
			>
				<div
					class="tc-live-reorderable-drop-placeholder"
					style.position="absolute"
					style.top=<<tf.lr.get-before-top>>
					style.left=<<tf.lr.get-before-left>>
					style.width=<<tf.lr.get-before-width>>
					style.height=<<tf.lr.get-before-height>>
					style.z-index=<<styleZIndex>>
				/>
			</$droppable>
			<$droppable
				class="tc-live-reorderable-drop-after"
				actions=<<live-reorder-drop-actions>>
				dragEnterActions=<<live-reorder-after-drag-enter-actions>>
			>
				<div
					class="tc-live-reorderable-drop-placeholder"
					style.position="absolute"
					style.top=<<tf.lr.get-after-top>>
					style.left=<<tf.lr.get-after-left>>
					style.width=<<tf.lr.get-after-width>>
					style.height=<<tf.lr.get-after-height>>
					style.z-index=<<styleZIndex>>
				/>
			</$droppable>
		<% endif %>
	</$draggable>
</$tiddler>
\end
