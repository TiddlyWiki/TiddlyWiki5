\procedure draggable-droppable-drag-end-actions()
<%if [<dragState>addsuffix[/drag-handled]is[missing]] %>
	<$let
		fromList={{{ [<dragState>get[start-from-list]] }}}
		fromIndex={{{ [<dragState>get[start-from-index]] }}}
		listBeforeTiddler={{{ [list<fromList>zth<fromIndex>] }}}
		actionTiddler={{{ [<actionTiddler>removeprefix<prefix>removesuffix<suffix>] :else[<actionTiddler>] }}}
	>
		<%if [<listBeforeTiddler>!is[blank]] %>
			<$action-listops
				$tiddler=<<fromList>>
				$subfilter="+[insertbefore<actionTiddler>,<listBeforeTiddler>]"
			/>
		<% else %>
			<$action-listops
				$tiddler=<<fromList>>
				$subfilter="[<actionTiddler>]"
			/>
		<% endif %>
		<$action-deletetiddler
			$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
		/>
		<$action-deletetiddler
			$tiddler=<<dragState>>
		/>
	</$let>
<% else %>
	<$action-deletetiddler
		$tiddler={{{ [<dragState>addsuffix[/drag-handled]] }}}
	/>
<% endif %>
\end

\procedure draggable-droppable-drag-start-actions()
<$let
	nth={{{ [list<list>allbefore<tiddler>count[]] }}}
	listLength={{{ [list<list>count[]subtract[1]] }}}
>
	<%if [<nth>match<listLength>] %>
		<$action-setfield
			$tiddler=<<dragState>>
			before-tiddler={{{ [list<list>before<tiddler>] }}}
		/>
	<% endif %>
	<$action-setfield
		$tiddler=<<dragState>>
		drag-count="0"
		nth=<<nth>>
		height={{{ [<tv-selectednode-exact-height>] :else[<tv-selectednode-height>] }}}
		width={{{ [<tv-selectednode-exact-width>] :else[<tv-selectednode-width>] }}}
		margin-bottom=<<styleMarginBottom>>
		start-next-tiddler={{{ [list<list>after<tiddler>] }}}
		start-from-index={{{ [list<list>allbefore<tiddler>count[]] }}}
		start-from-list=<<list>>
	/>
	<$action-setfield
		$tiddler=<<dragState>>
		drag-tiddler=<<tiddler>>
		next-tiddler={{{ [list<list>after<tiddler>] }}}
		from-index={{{ [list<list>allbefore<tiddler>count[]] }}}
		from-list=<<list>>
		from-history=<<history>>
		target={{{ [list<list>after<tiddler>] }}}
	/>
	<$action-setfield
		$tiddler=<<dragState>>
		tags="$:/tags/dragState"
		text="yes"
	/>
	<%if [<modifier>!match[ctrl]] %>
		<$action-listops
			$tiddler=<<list>>
			$subfilter="-[<tiddler>]"
		/>
	<% else %>
		<$action-setfield
			$tiddler=<<dragState>>
			copy="yes"
		/>
	<% endif %>
</$let>
\end

\function tf.get-drag-state-tiddler-height() [<dragState>get[height]addsuffix[px]]
\function tf.get-drag-state-tiddler-margin-bottom() [<dragState>get[margin-bottom]]

\function tf.get-draggable-droppable-bottom-class() tc-draggable-droppable-drop-bottom [<dragState>get[margin]match[bottom]then<qualifiedDragEnterClass>] :and[join[ ]]
\function tf.get-draggable-droppable-top-class() tc-draggable-droppable-drop-top [<dragState>get[margin]match[top]then<qualifiedDragEnterClass>] :and[join[ ]]

\function tf.get-tiddler-before-target() [<dragState>get[target]] :reduce[list<list>before<currentTiddler>]
\function tf.get-tiddler-after-target() [<dragState>get[target]] :reduce[list<list>after<currentTiddler>]

\function tf.get-restart-nudge() [<dragState>get[drag-count]remainder[2]divide[10]addsuffix[px]] :else[[0px]]

\function tf.is-gap-holder() [<dragState>get[start-next-tiddler]match<tiddler>then[yes]] :else[<dragState>get[before-tiddler]match<tiddler>then[yes]] :else[[no]]

\function tf.get-animationDuration()
	[<dragState>get[height]divide<animationReferenceHeight>power[0.5]multiply<animationDuration>max<animationMinDuration>min<animationMaxDuration>round[]]
	:else[<animationDuration>]
\end

\function tf.get-margin-transition-value() [[margin-top ]addsuffix<tf.get-animationDuration>addsuffix[ms ]addsuffix<animationCurve>addsuffix[, margin-bottom ]addsuffix<tf.get-animationDuration>addsuffix[ms ]addsuffix<animationCurve>]
\function tf.get-placeholder-transition-value() [[top ]addsuffix<tf.get-animationDuration>addsuffix[ms ]addsuffix<animationCurve>addsuffix[, height ]addsuffix<tf.get-animationDuration>addsuffix[ms ]addsuffix<animationCurve>]

\function tf.get-styleTransition()
	[<tf.is-gap-holder>match[yes]then[none]]
	:else[<dragState>get[text]match[yes]then<tf.get-margin-transition-value>]
	:else[[none]]
\end

\function tf.get-placeholderTransition()
	[<tf.is-gap-holder>match[yes]then[none]]
	:else[<dragState>get[text]match[yes]then<tf.get-placeholder-transition-value>]
	:else[[none]]
\end

\function tf.get-gap-size-top() [[calc(]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ + (2 * ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[))]]
\function tf.get-gap-zero-top() [[calc(]addsuffix<tf.get-restart-nudge>addsuffix[)]]
\function tf.get-gap-size-bottom() [[calc(0px - ]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ + (2 * ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[))]]
\function tf.get-gap-zero-bottom() [[calc(0px - ]addsuffix<tf.get-restart-nudge>addsuffix[)]]

\function tf.get-styleTop()
	[<tf.is-gap-holder>match[yes]then[calc(0px - ]addsuffix<tf.get-restart-nudge>addsuffix[ - ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ - ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[)]]
	:else[<dragState>get[drag-enter-class]match<qualifiedDragEnterClass>then<dragState>get[margin]match[top]then[calc(0px - ]addsuffix<tf.get-restart-nudge>addsuffix[ - ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ - ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[)]]
	:else[[calc(0px - ]addsuffix<tf.get-restart-nudge>addsuffix[ - ]addsuffix<styleMarginTop>addsuffix[)]]
\end

\function tf.get-styleBottom() [[calc( ]addsuffix[-]addsuffix<styleMarginBottom>addsuffix[)]]
\function tf.get-styleLeft() [[calc( ]addsuffix[-]addsuffix<stylePaddingLeft>addsuffix[)]]

\function tf.get-styleTopHeight()
	[<tf.is-gap-holder>match[yes]then[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[)]]
	:else[<dragState>get[drag-enter-class]match<qualifiedDragEnterClass>then<dragState>get[margin]match[top]then[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[ + (2 * ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[) + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[)]]
	:else[[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<styleMarginBottom>addsuffix[)]]
\end

\function tf.get-styleBottomHeight()
	[<dragState>get[before-tiddler]match<tiddler>then[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[)]]
	:else[<dragState>get[drag-enter-class]match<qualifiedDragEnterClass>then<dragState>get[margin]match[bottom]then[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-height>addsuffix[ + ]addsuffix<tf.get-drag-state-tiddler-margin-bottom>addsuffix[)]]
	:else[[calc(50% + ]addsuffix<tf.get-restart-nudge>addsuffix[)]]
\end

\function tf.get-styleWidth() [[calc(100% + ]addsuffix<stylePaddingLeft>addsuffix[ + ]addsuffix<stylePaddingRight>addsuffix[)]]

\function tf.get-styleMarginTop()
	[<dragState>get[start-next-tiddler]match<tiddler>then<tf.get-gap-size-top>]
	:else[<dragState>get[drag-enter-class]match<qualifiedDragEnterClass>then<dragState>get[margin]match[top]then<tf.get-gap-size-top>]
	:else[<tf.get-gap-zero-top>]
\end

\function tf.get-styleMarginBottom()
	[<dragState>get[before-tiddler]match<tiddler>then<tf.get-gap-size-bottom>]
	:else[<dragState>get[drag-enter-class]match<qualifiedDragEnterClass>then<dragState>get[margin]match[bottom]then<tf.get-gap-size-bottom>]
	:else[<tf.get-gap-zero-bottom>]
\end

\function tf.get-draggable-droppable-class() tc-draggable-droppable-qualifier [<qualifiedDragEnterClass>] :and[join[ ]]
\function tf.get-flexDirection() [<direction>match[vertical]then[row]] [<direction>match[horizontal]then[column]]

\procedure make-draggable-droppable(tiddler:"",class:"",content:"",list:"",enable:"yes",dropActions:"",history:"",dragState:"$:/state/tiddlywiki/dragging",direction:"vertical",styleMarginTop:"0px",styleMarginBottom:"0px",stylePaddingLeft:"0px",stylePaddingRight:"0px",styleZIndex:"501",animationDuration:"175",animationReferenceHeight:"240",animationMinDuration:"90",animationMaxDuration:"400",animationCurve:"ease-out")
\whitespace trim
<$tiddler tiddler=<<tiddler>>>
<$let
	prefix="[["
	suffix="]]"
	transclusion=<<tiddler>>
	qualifiedDragEnterClass={{{ [<tiddler>addsuffix<qualify>sha256[64]] }}}
>
	<$draggable
		enable=<<enable>>
		tiddler=<<tiddler>>
		startactions=<<draggable-droppable-drag-start-actions>>
		endactions=<<draggable-droppable-drag-end-actions>>
		class=<<class>>
		style.display="flow-root"
	>
		<div
			class=<<tf.get-draggable-droppable-class>>
			style.display="flex"
			style.position="relative"
			style.flex-direction=<<tf.get-flexDirection>>
			style.border="none"
			style.margin-top=<<tf.get-styleMarginTop>>
			style.margin-bottom=<<tf.get-styleMarginBottom>>
			style.transition=<<tf.get-styleTransition>>
		>
			<$set name="tv-enable-drag-and-drop" value={{{ [<enable>match[yes]then[no]] :else[<tv-enable-drag-and-drop>] }}}>
				<<content>>
			</$set>
			<%if [<dragState>get[text]match[yes]] %>
				<%if [<direction>match[vertical]] %>
					<$droppable
						class=<<tf.get-draggable-droppable-top-class>>
						actions=<<draggable-droppable-top-drop-actions>>
						dragEnterActions=<<draggable-droppable-top-drag-enter-actions>>
					>
						<div
							class="tc-draggable-droppable-drop-top-placeholder"
							style.position="absolute"
							style.border="none"
							style.top=<<tf.get-styleTop>>
							style.left=<<tf.get-styleLeft>>
							style.height=<<tf.get-styleTopHeight>>
							style.width=<<tf.get-styleWidth>>
							style.z-index=<<styleZIndex>>
							style.transition=<<tf.get-placeholderTransition>>
						/>
					</$droppable>
					<$droppable
						class=<<tf.get-draggable-droppable-bottom-class>>
						actions=<<draggable-droppable-bottom-drop-actions>>
						dragEnterActions=<<draggable-droppable-bottom-drag-enter-actions>>
					>
						<div
							class="tc-draggable-droppable-drop-bottom-placeholder"
							style.position="absolute"
							style.border="none"
							style.top="50%"
							style.left=<<tf.get-styleLeft>>
							style.height=<<tf.get-styleBottomHeight>>
							style.width=<<tf.get-styleWidth>>
							style.z-index=<<styleZIndex>>
							style.transition=<<tf.get-placeholderTransition>>
						/>
					</$droppable>
				<%elseif [<direction>match[horizontal]] %>
					<!-- horizontal handling missing at the moment -->
				<% endif %>
			<% endif %>
		</div>
	</$draggable>
</$let>
</$tiddler>
\end
