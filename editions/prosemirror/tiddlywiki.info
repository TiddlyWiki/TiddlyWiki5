	"description": "Standalone demonstration of the experimental ProseMirror editor",
	"plugins": [
		"tiddlywiki/prosemirror",
		"tiddlywiki/editor-command-menu",
		"tiddlywiki/wikitext-serialize",
		"tiddlywiki/hard-line-breaks"
