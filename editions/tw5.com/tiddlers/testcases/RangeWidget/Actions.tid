title: TestCases/RangeWidget/Actions
type: text/vnd.tiddlywiki-multiple

title: Narrative

The sliders store their values in the integer-value and fractional-value fields of Output. Enable "Show log" to inspect the actions fired when dragging starts, the value changes, and dragging stops. Each entry includes the event, actionValue, and actionValueHasChanged. Entries in the log tiddler are numbered so that events fired within the same millisecond do not overwrite each other. Use "Clear Log" to reset the log.
+
title: Output
integer-value: 1
fractional-value: 0.01
show-log: no

\procedure range-log(event)
<$let entry=`$(event)$ - value: $(actionValue)$ - changed: $(actionValueHasChanged)$`>
<$action-setfield $tiddler="log" $index={{{ [[log]indexes[]count[]add[1]] }}} $value=<<entry>>/>
</$let>
\end

<$range field="integer-value" min="-1" max="10" increment="1"
  actionsStart="<<range-log actionsStart>>" actionsStop="<<range-log actionsStop>>" actions="<<range-log actions>>"/> {{!!integer-value}}

<$range field="fractional-value" min="0" max="1" increment="0.01"
  actionsStart="<<range-log actionsStart>>" actionsStop="<<range-log actionsStop>>" actions="<<range-log actions>>"/> {{!!fractional-value}}

<$checkbox field="show-log" checked="yes" unchecked="no"> Show log</$checkbox>
<$button><$action-setfield $tiddler="log" text="{}"/>Clear Log</$button>

<$reveal state="!!show-log" type="match" text="yes">
<$transclude tiddler="log"/>
</$reveal>
+
title: log
type: application/json

