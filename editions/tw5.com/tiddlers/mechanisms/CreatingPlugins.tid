\define plugin-fields() 
[
  {
    "field": "name",
    "description": "Brief name of the plugin.",
    "optional": false
  },
  {
    "field": "description",
    "description": "Description of plugin.",
    "optional": false
  },
  {
    "field": "plugin-type",
    "caption":"Type",
    "description": "Generally plugin, language or theme.",
    "optional": false
  },
  {
    "field": "author",
    "description": "Author of plugin.",
    "optional": true
  },
  {
    "field": "version",
    "description": "Version string (should conform to semantic versioning convention).",
    "optional": true
  },
  {
    "field": "stability",
    "description": "Development state of the plugin",
    "optional": true
  },
  {
    "field": "core-version",
    "description": "TiddlyWiki core version required for this plugin to function properly (e.g., >=5.1.22).",
    "optional": true
  },
  {
    "field": "platform",
    "description": "Set this field to node to restrict the plugin to only be loaded on the server.",
    "optional": true
  },
  {
    "field": "parent-plugin",
    "caption":"Parent",
    "description": "Title of the plugin under which this plugin should be displayed as a sub-plugin in the control panel plugin chooser.",
    "optional": true
  },
  {
    "field": "dependents",
    "description": "List of dependencies: plugins that should be installed in order for this one to work.",
    "optional": false
  },
  {
    "field": "plugin-priority",
    "caption":"Priority",
    "description": "Numerical priority (higher numbers install later, the core plugin has a priority of zero).",
    "optional": true
  },
  {
    "field": "source",
    "description": "Source URL of plugin.",
    "optional": true
  },
  {
    "field": "list",
    "description": "Names of exposed plugin information tiddlers (readme, license, ..)",
    "optional": false
  },
  {
    "field": "plugin-filter",
    "description": "Filter expression used to select the tiddlers for the plugin.",
    "optional": false
  }
]
\end

\function plugin.types() plugin language theme [each:list-item[plugin-type]] -info -import 

\function field.value() [<..currentTiddler>get{!!title}]

\function json.fields()
[{!!title}fields:exclude[created creator modified modifier title bag revision]]
:filter[<field.value>!is[blank]]
text
:reduce[<accumulator>jsonset{!!title},<field.value>]
\end

\function json.plugin()
[subfilter{!!plugin-filter}]
:reduce[<accumulator>jsonset:json{!!title},<json.fields>]
:map[[]jsonset:json[tiddlers],{!!title}]
\end

\procedure change-actions()
<$action-setfield 
  $tiddler={{!!plugin-title}} 
  plugin-type={{{ [{!!plugin-title}get[plugin-type]!is[blank]else[plugin]] }}} 
  type="application/json"
/>
\end

\procedure update-plugin(plugin-title)
<$action-setfield
$tiddler=<<plugin-title>>
text=<<json.plugin>>
plugin-filter={{{ [{!!plugin-filter}!is[blank]]  ~"[{!!title}plugintiddlers[]]" }}}
/>
<%if [{!!delete-override-tiddlers}match[true]] %>
<$action-deletetiddler $filter={{!!plugin-filter}}/>
<%endif%>
\end

\function plugins.filter() [has[plugin-type]] -[[$:/temp/info-plugin]] -[[$:/core]] -[[$:/Import]]

\procedure export-plugin-action()
<$action-sendmessage $message="tm-download-file" $param="$:/core/templates/exporters/JsonFile" exportFilter={{!!title}} filename=`${[{!!title}]}$_${[{!!version}!is[blank]else[0.0.0]]}$.json` type="application/json" />
\end

\procedure setVersionFieldButtons()
\procedure setVersionFieldAction()
<$let updated={{{ [<modifier>match[ctrl]then[-1]else[1]add<dom-data-versionPart>max[0]] }}} >
<%if [<updated>!match<dom-data-versionPart>]%>
<$action-setfield  version={{{
[<version>split[.]]
:map[<index>add[1]match<dom-data-nth>then<updated>else{!!title}]
+[join[.]]
}}}/>
<%endif%>
\end setVersionFieldAction
<$let version={{{ [{!!version}!is[blank]else[0.0.0]] }}} >
<$eventcatcher selector="button" $click=<<setVersionFieldAction>> tag="div">
<$list filter="[<version>split[.]]" variable="versionPart" counter="nth">
<$genesis 
$type="button" 
data-versionPart=<<versionPart>>
data-nth=<<nth>>
title={{{ "Breaking changes" "Backward compatible changes" "Bug fixes" +[nth<nth>] }}}
><<versionPart>></$genesis>
</$list>
</$eventcatcher>
</$let>
\end setVersionFieldButtons

<!-- diff viewer -->

\function get.destField(subTiddler,field) [<subTiddler>get<field>]

\function get.sourceField(subTiddler,field) [<subTiddler>shadowsource[]get[text]jsonget[tiddlers],<subTiddler>,<field>]

\function get.sourceFields(subTiddler) [<subTiddler>shadowsource[]]:map:flat[<subTiddler>subtiddlerfields{!!title}]

\function has.diff(subTiddler,field) [get.destField<subTiddler>,<field>else[]]:filter[get.sourceField<subTiddler>,<field>else[]!match{!!title}]

\function diff.fields(subTiddler) [get.sourceFields<subTiddler>] [<subTiddler>fields:exclude[created creator modified modifier title]] :filter[has.diff<subTiddler>,{!!title}]

\procedure subTiddler-list-item()
\procedure subTiddler-link()
<$link to=<<subTiddler>> >
<%if [<subTiddler>prefix<plugin-title>]%>
<span class="tc-system-title-prefix">../</span><$text text={{{ [<subTiddler>removeprefix<plugin-title>trim[/]] }}}/>
<%else%>
<$text text=<<subTiddler>> />
<%endif%>
</$link>
\end subTiddler-link
<$let state=`$:/state/peek-tiddler/open/$(subTiddler)$$(qualify)$`>
<li>
<<subTiddler-link>>
<%if [diff.fields<subTiddler>] %>
<$checkbox tiddler=<<state>> field="text" checked="show" style.appearance="none">
<span style="cursor:pointer;display:inline-block;width:11pt"><%if [<state>get[text]]%>{{$:/core/images/preview-open}}<%else%>{{$:/core/images/preview-closed}}<%endif%></span>
</$checkbox>
<%endif%>
<%if [<state>get[text]]%>
<$list filter="[diff.fields<subTiddler>]" variable=field>
<$diff-text source={{{ [get.sourceField<subTiddler>,<field>] }}} dest={{{ [get.destField<subTiddler>,<field>] }}} >
<code><<field>></code>: <<diff-count>> difference<%if [<diff-count>!match[1]]%>s<%endif%>
</$diff-text>
</$list>
<%endif%>
</li>
</$let>
\end subTiddler-list-item

You can use the table bellow to create and update plugins directly from TiddlyWiki. Select a plugin, theme, or language using the dropdown in the first row. You can quickly filter the list by typing a name directly into the adjacent input field.

<$tiddler tiddler="$:/temp/plugin">

<$eventcatcher matchSelector=":is(select,input):not(.plugin-title *)" $change=<<change-actions>>   tag="table"  class="tc-max-width tc-edit-max-width">
<tr class="plugin-title">
<td title="Title of plugin">
<$select field="plugin-title" default={{!!plugin-title}} style.width="20ch">
<option disabled value={{!!plugin-title}} style="display:none">Plugin title</option>
<$list filter="[function[plugin.types]]" variable="optgroup-label">
<optgroup label={{{ [<optgroup-label>titlecase[]] }}} >
<$list filter="
[function[plugins.filter]plugin-type<optgroup-label>search:title{!!plugin-title}]
" variable="name">
<$genesis
$type="option"
value={{{ [<name>!match{!!plugin-title}] }}}
$names="disabled title :filter[<name>match{!!plugin-title}]"
$values="=true =[[Plugin selected]]">
<$text text={{{ [<name>get[name]else<name>split[/]last[]] }}} />
</$genesis>
</$list>
</optgroup>
</$list>
</$select>
</td>
<td>
<$edit field="plugin-title"/>
</td>
</tr>
<$tiddler tiddler={{!!plugin-title}} >
<$list filter="[<plugin-fields>jsonindexes[]]" variable="field-index">
<$let 
field={{{ [<plugin-fields>jsonget<field-index>,[field]] }}} 
optional={{{ [<plugin-fields>jsonget<field-index>,[optional]] }}}
caption={{{ [<plugin-fields>jsonget<field-index>,[caption]else<field>split[-]join[ ]sentencecase[]] }}}
description={{{ [<plugin-fields>jsonget<field-index>,[description]] }}}
>
<tr>
<td title=<<description>> ><<caption>> <%if [<optional>match[true]]%><span style.color="var(--tpc-muted-foreground)">(optional)</span><%endif%></td>
<td>
<%if [<field>match[stability]]%>
<$select field="stability" default="STABILITY_1_EXPERIMENTAL">
<$list filter="deprecated experimental stable legacy" counter="stability">
<option value={{{STABILITY [<stability>add[-1]] [{!!title}uppercase[]] +[join[_]] }}}>{{!!title}}</option>
</$list>
</$select>
<%elseif [<field>match[version]]%>
<<setVersionFieldButtons>>
<%elseif [<field>match[plugin-type]]%>
<$select field="plugin-type" default="plugin">
<$list filter="[function[plugin.types]]">
<option value={{!!title}} >{{!!title}}</option>
</$list>
</$select>
<%elseif [<field>match[plugin-filter]]%>
<$edit field="plugin-filter" tag="textarea" class="tc-edit-texteditor"/>
<%else%>
<$edit field=<<field>> />
<%endif%>
</td>
</tr>
</$let>
</$list>
</$tiddler>
</$eventcatcher>

<$tiddler tiddler={{!!plugin-title}} >

<%if [{!!title}!is[blank]] %>

<$let plugin-type={{!!plugin-type}} qualified-state=<<qualify "$:/state/plugin-info">> >
{{||$:/core/ui/Components/plugin-info}}
</$let>

<$button actions="""<<export-plugin-action>>""">
  {{$:/core/images/export-button}} Export Plugin
</$button>

<%if [subfilter{!!plugin-filter}is[tiddler]] %>

<p>
//Modified/New tiddlers to be packaged://
</p>

<$let 
plugin-tiddler-list-pages-max="20"
plugin-tiddler-list-pages={{{ [subfilter{!!plugin-filter}is[tiddler]count[]divide<plugin-tiddler-list-pages-max>add[.5]round[]] }}}
skip={{{ [<currentTiddler>get[page]else[0]multiply<plugin-tiddler-list-pages-max>] }}}
>
<ul>
<$list filter="[subfilter{!!plugin-filter}is[tiddler]butfirst<skip>limit<plugin-tiddler-list-pages-max>]" variable="subTiddler" counter="counter">
<div style="display:flex;gap:2ch;"><$text text={{{ [{!!page}multiply<plugin-tiddler-list-pages-max>add<counter>] }}} /><$transclude $variable="subTiddler-list-item"/></div>
</$list>
</ul>
</$let>

<%if [<plugin-tiddler-list-pages>compare:number:gt[1]] %>
<span>
<$button disabled={{{  [{!!page}compare:number:gt[0]then[no]else[yes]] }}} set="!!page" setTo={{{ [{!!page}add[-1]compare:number:gt[0]else[0]] }}}>{{$:/core/images/left-arrow}}</$button>
<span><$text text={{{ [{!!page}add[1]] }}} /> / <<plugin-tiddler-list-pages>></span>
<$button disabled={{{ [{!!page}add[1]compare:number:lt<plugin-tiddler-list-pages>then[no]else[yes]] }}} set="!!page" setTo={{{ [{!!page}add[1]compare:number:lt<plugin-tiddler-list-pages>else{!!page}] }}}>{{$:/core/images/right-arrow}}</$button>
</span>
<%endif%>

<%endif%>

<$button actions="""<$transclude $variable="update-plugin" plugin-title={{!!title}} />""">
  {{$:/core/images/refresh-button}} Update Plugin
</$button>
<$checkbox field="delete-override-tiddlers" checked="true">  Merge override tiddlers into the plugin</$checkbox>

<%endif%>

</$tiddler>
